{{- /* Per-machine answers, asked once on `chezmoi init` and kept in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $rootbook := promptBoolOnce . "rootbook" "Is this the rootbook (ASUS) laptop" -}}
{{- $work := promptBoolOnce . "work" "Install work packages" -}}
{{- $email := promptStringOnce . "vaultwarden_email" "Vaultwarden login email" -}}

[data]
    rootbook = {{ $rootbook }}
    work = {{ $work }}
    vaultwarden_email = {{ $email | quote }}

# Templates fetch secrets with rbw, so install and configure it before they are read.
[hooks.read-source-state.pre]
    command = {{ joinPath .chezmoi.sourceDir ".install-password-manager.sh" | quote }}
    args = [{{ $email | quote }}]
