export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git fzf)

source $ZSH/oh-my-zsh.sh

# zsh-autosuggestions from the pacman package (not an oh-my-zsh custom plugin)
[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

export PATH="$PATH:/opt/nvim/"

eval "$(zoxide init zsh)"

#############
#   ALIASE  #
#############
alias cd='z'
alias cat='bat --paging=never'
alias nano='nvim'
alias vi='nvim'
alias vim='nvim'
alias nosleep='systemd-inhibit --what=sleep --why="long-running task"'
alias fullcharge='sudo tlp fullcharge'   # charge to 100% until next boot (default limit 80%)

export PATH="$HOME/.local/bin:$PATH"


# Load notebook-specific (local/work) configs that aren't managed by chezmoi
if [[ -d "$HOME/.config/zsh/local.d" ]]; then
  for config in "$HOME/.config/zsh/local.d"/*.zsh(N); do
    source "$config"
  done
fi

