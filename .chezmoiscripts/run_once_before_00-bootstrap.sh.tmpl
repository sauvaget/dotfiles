{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/bin/bash
# Tools the package script needs: base-devel + git to build AUR packages, yay as AUR helper.
set -euo pipefail

missing=$(pacman -T base-devel git || true)
if [ -n "$missing" ]; then
    echo "bootstrap: installing $missing"
    sudo pacman -S --needed $missing
fi

if ! command -v yay >/dev/null; then
    echo "bootstrap: installing yay"
    tmp=$(mktemp -d)
    git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay-bin"
    # build, then install only yay-bin itself (not the yay-bin-debug package makepkg also produces)
    (cd "$tmp/yay-bin" && makepkg -s --noconfirm && sudo pacman -U --noconfirm yay-bin-[0-9]*.pkg.tar.zst)
    rm -rf "$tmp"
fi
{{ end -}}
