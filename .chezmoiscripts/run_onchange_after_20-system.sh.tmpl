{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/bin/bash
# Installs system/<group>/ files to /, enables services and adds the user to groups.
# Only uses sudo when something differs. Re-runs when any file or setting below changes.
set -euo pipefail

{{- $groups := list "base" "desktop" "apps" "cli" "devops" }}
{{- if get . "hardware" }}{{ $groups = append $groups "hardware" }}{{ end }}
{{- if get . "work" }}{{ $groups = append $groups "work" }}{{ end }}

# groups: {{ $groups | join " " }}
# file hashes (so this script re-runs when a system file changes):
{{- range $g := $groups }}
{{- $dir := joinPath $.chezmoi.sourceDir "system" $g }}
{{- if stat $dir }}
{{ output "find" $dir "-type" "f" "-exec" "sha256sum" "{}" "+" | comment "#   " | trim }}
{{- end }}
{{- end }}

src="{{ .chezmoi.sourceDir }}/system"
groups=({{ $groups | join " " }})
services=(
{{- range $g := $groups }}{{ range get (get $.system $g | default dict) "services" | default list }} {{ . }}{{ end }}{{ end }} )
user_services=(
{{- range $g := $groups }}{{ range get (get $.system $g | default dict) "user_services" | default list }} {{ . }}{{ end }}{{ end }} )
user_groups=(
{{- range $g := $groups }}{{ range get (get $.system $g | default dict) "user_groups" | default list }} {{ . }}{{ end }}{{ end }} )
login_shell="{{ get $.system.base "login_shell" }}"

same() {  # same <src> <dst>: identical content. Missing or root-only dst (e.g. in /etc/sudoers.d) is checked via sudo.
    if [ -r "$2" ]; then cmp -s "$1" "$2"; else sudo cmp -s "$1" "$2" 2>/dev/null; fi
}

changed=0
for g in "${groups[@]}"; do
    [ -d "$src/$g" ] || continue
    while IFS= read -r -d '' file; do
        dst="/${file#"$src/$g/"}"
        same "$file" "$dst" && continue
        mode=0644
        if [[ $dst == /etc/sudoers.d/* ]]; then
            mode=0440
            visudo -cqf "$file" || { echo "system: $file is not valid sudoers syntax, skipping"; continue; }
        fi
        echo "system: installing $dst"
        sudo install -D -o root -g root -m "$mode" "$file" "$dst"
        changed=1
        [[ $dst == /etc/mkinitcpio.conf* ]] && initramfs=1
    done < <(find "$src/$g" -type f -print0)
done
if [ "$changed" = 1 ]; then
    sudo systemctl daemon-reload
    sudo udevadm control --reload
fi
if [ "${initramfs:-0}" = 1 ]; then
    echo "system: mkinitcpio config changed, rebuilding initramfs"
    sudo mkinitcpio -P
fi

for s in "${services[@]}"; do
    systemctl is-enabled --quiet "$s" 2>/dev/null && continue
    echo "system: enabling $s"
    sudo systemctl enable "$s"
done

for s in "${user_services[@]}"; do
    systemctl --user is-enabled --quiet "$s" 2>/dev/null && continue
    echo "system: enabling user unit $s"
    systemctl --user enable "$s"
done

for grp in "${user_groups[@]}"; do
    id -nG "$USER" | tr ' ' '\n' | grep -qx "$grp" && continue
    echo "system: adding $USER to group $grp (takes effect at next login)"
    sudo usermod -aG "$grp" "$USER"
done

if [ -n "$login_shell" ] && [ "$(getent passwd "$USER" | cut -d: -f7)" != "$login_shell" ]; then
    echo "system: changing login shell to $login_shell (takes effect at next login)"
    sudo chsh -s "$login_shell" "$USER"
fi
{{ end -}}
