{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "backlight", "sway/language", "network", "bluetooth", "custom/power", "battery", "tray"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/language": {
        "format": "  {short}",
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
	"bat": "BAT0",
	"interval": 30, // Poll every 30 seconds
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
	"format-charging": "{capacity}% ⚡", // Icon or text to show when charging
        "format-plugged": "{capacity}% ",  // When plugged in but NOT charging
        "format-icons": ["", "", "", "", ""]
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "",
        "on-click": "pavucontrol"
    },

    "backlight": {
        "format": "  {percent}%"
    },

    "network": {
        "format-wifi": "  {essid} {signalStrength}%",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "  offline",
        "tooltip-format-wifi": "{ifname}: {ipaddr}/{cidr}\n{essid} ({signalStrength}%, {frequency} GHz)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "networkmanager_dmenu",
        "on-click-right": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "  on",
        "format-off": "  off",
        "format-disabled": "",
        "format-connected": "  {device_alias}",
        "format-connected-battery": "  {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}  {controller_address}",
        "tooltip-format-connected": "{controller_alias}  {controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_address}  {device_battery_percentage}%",
        "on-click": "rofi-bluetooth -theme ~/.config/rofi/network.rasi"
    },

    "custom/power": {
        "exec": "~/.config/sway/scripts/power-profile-status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "on-click": "~/.config/sway/scripts/power-profile"
    }
}

