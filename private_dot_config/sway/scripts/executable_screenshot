#!/usr/bin/env bash
# Screenshots for sway: saves to ~/Pictures/Screenshots and copies to the clipboard.
#   screenshot region   select an area with the mouse
#   screenshot window   the focused window
#   screenshot screen   the focused monitor
#   screenshot edit     select an area and annotate it in satty before saving
set -euo pipefail

dir="$HOME/Pictures/Screenshots"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
mkdir -p "$dir"

case "${1:-region}" in
    region)
        geom=$(slurp) || exit 0          # Esc cancels
        grim -g "$geom" "$file" ;;
    window)
        geom=$(swaymsg -t get_tree | jq -r '.. | select(.focused? == true) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')
        grim -g "$geom" "$file" ;;
    screen)
        output=$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')
        grim -o "$output" "$file" ;;
    edit)
        geom=$(slurp) || exit 0
        # satty saves with Ctrl+S (to $file) and copies with Ctrl+C; closing without either discards
        grim -g "$geom" - | satty --filename - --output-filename "$file" \
            --copy-command wl-copy --early-exit --initial-tool arrow
        exit 0 ;;
    *)
        sed -n '3,7p' "$0"; exit 1 ;;
esac

wl-copy --type image/png < "$file"
notify-send -t 3000 -i "$file" "Screenshot" "Saved to ${file/#$HOME/\~} and copied"
