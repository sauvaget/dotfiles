/* Dropdown for networkmanager_dmenu, anchored under the waybar network box */

configuration {
    show-icons: false;
}

* {
    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       #ffffff;
}

window {
    location:         north east;
    anchor:           north east;
    x-offset:         -10px;
    y-offset:         6px;    /* below waybar's reserved zone */
    width:            360px;
    padding:          6px;
    background-color: rgba(43, 48, 59, 0.9);
    border:           2px;
    border-color:     #5294e2;
    border-radius:    8px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  6px;
}

inputbar {
    children:         [ entry ];
    padding:          6px 8px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius:    8px;
}

entry {
    placeholder:       "Search...";
    placeholder-color: rgba(255, 255, 255, 0.5);
}

listview {
    lines:        14;
    fixed-height: false;
    scrollbar:    false;
}

element {
    padding:       5px 8px;
    border-radius: 8px;
}

element selected {
    background-color: rgba(82, 148, 226, 0.5);
}

element-text {
    background-color: inherit;
    text-color:       inherit;
}
